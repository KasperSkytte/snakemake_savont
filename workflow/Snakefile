# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.
from snakemake.utils import min_version

min_version("9.0.0")


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/01-trim.smk"
include: "rules/02-asv.smk"
include: "rules/03-classify.smk"
include: "rules/04-export.smk"
include: "rules/05-usearch.smk"


rule all:
    input:
        os.path.join(config["output_dir"], "read_counts.tsv"),
        result("asvs.fasta"),
        result("abund_table_savont.tsv"),
        result("taxonomy_savont.tsv") if config["classify_savont"] else [],
        (
            result("taxonomy_usearch_sintax.tsv")
            if config["classify_usearch_sintax"]
            else []
        ),
        (
            result("taxonomy_savont_sintax.tsv")
            if config["classify_savont_sintax"]
            else []
        ),
        result("abund_table_usearch.tsv") if config["abund_usearch"] else [],
